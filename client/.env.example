# Copy this file to .env.local and adjust.

# Where the Express API lives. Server-side only: next.config.ts forwards /api/* here.
# Read at build / start time, so set it in the deployment environment too.
API_URL=http://localhost:5000/api/v1

# Must be the SAME value as JWT_SECRET in server/.env. proxy.ts uses it to check the login
# cookie before rendering a page. Server-side only (no NEXT_PUBLIC_ prefix).
JWT_SECRET=replace-with-the-same-secret-as-the-server

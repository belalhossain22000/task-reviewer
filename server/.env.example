NODE_ENV="development"
PORT=5000

DATABASE_URL="postgresql://review:review@localhost:5433/review?schema=public"

BCRYPT_SALT_ROUNDS=12
JWT_SECRET="replace-with-a-long-random-string"
EXPIRES_IN="7d"

# Seed users (npx prisma db seed)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-Admin1"
# Optional demo mentor
MENTOR_EMAIL="mentor@example.com"
MENTOR_PASSWORD="change-me-Mentor1"

# Browser origins allowed to call the API (comma separated)
CLIENT_ORIGIN="http://localhost:3000"
# Number of reverse proxies in front of the API (0 = clients connect directly).
# Set to 1 (or more) only when the API runs behind a reverse proxy / hosting platform, so per-IP
# rate limits see real client IPs. Keep 0 for local development, otherwise X-Forwarded-For can be spoofed.
TRUST_PROXY=0

# Optional rate limit overrides
# SUBMISSION_RATE_LIMIT_MAX=5
# SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=10
# GLOBAL_RATE_LIMIT_MAX=300

NODE_ENV="development"
PORT=5000

DATABASE_URL="postgresql://review:review@localhost:5433/review?schema=public"
# Same database without a connection pooler (used by `prisma migrate`). With Neon, DATABASE_URL is the
# "-pooler" host plus `&pgbouncer=true`, and this is the host without "-pooler".
DIRECT_URL="postgresql://review:review@localhost:5433/review?schema=public"

BCRYPT_SALT_ROUNDS=12
# Local development only. In production use a long random string (e.g. `openssl rand -hex 32`)
# and put the SAME value in client/.env.local (the Next.js app checks the login cookie with it).
JWT_SECRET="dev-only-secret-change-me-in-production"
EXPIRES_IN="7d"

# Seed users (npx prisma db seed)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
# Demo accounts for local use. Change these before deploying anywhere public.
ADMIN_PASSWORD="Admin@12345"
# Optional demo mentor
MENTOR_EMAIL="mentor@example.com"
MENTOR_PASSWORD="Mentor@12345"

# Browser origins allowed to call the API (comma separated)
CLIENT_ORIGIN="http://localhost:3000"
# Number of proxies in front of the API. 1, because the Next.js app forwards /api/* to Express
# (and a hosting platform's load balancer counts as one too). It makes per-IP rate limits see the
# real client IP. Use 0 only if clients connect to the API directly, otherwise X-Forwarded-For can be spoofed.
TRUST_PROXY=1

# Optional rate limit overrides
# SUBMISSION_RATE_LIMIT_MAX=5
# SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=10
# GLOBAL_RATE_LIMIT_MAX=300

# How long "I'm reviewing this" holds a pending project before someone else may take it (minutes)
# CLAIM_TTL_MINUTES=30

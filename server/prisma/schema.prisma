generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Same database without a connection pooler: `prisma migrate` needs a direct connection (it takes
  // a lock a pooler such as Neon's PgBouncer does not support). Locally both are the same URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects         Project[]       @relation("ProjectStudent")
  reviewedProjects Project[]       @relation("ProjectReviewer")
  // Every decision this person has made, not only the latest one on each project.
  authoredReviews  ProjectReview[] @relation("ReviewAuthor")
  // Pending projects this person has taken ("I'm reviewing this").
  claimedProjects  Project[]       @relation("ProjectClaimer")

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  repoUrl     String
  repoKey     String        @unique
  liveUrl     String
  liveKey     String        @unique
  description String
  status      ProjectStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  studentId  String
  student    User    @relation("ProjectStudent", fields: [studentId], references: [id], onDelete: Restrict)
  reviewerId String?
  reviewer   User?   @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  // "I'm reviewing this": a soft claim a mentor puts on a PENDING project so two people don't work
  // on it at once. It counts only for CLAIM_TTL_MINUTES after `claimedAt`, and is cleared when the
  // project is decided or released.
  claimedById String?
  claimedBy   User?     @relation("ProjectClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt   DateTime?

  reviews ProjectReview[]

  @@index([claimedById])
  @@index([status, createdAt])
  @@index([studentId, createdAt])
  @@map("projects")
}

// One row per decision. `Project.status / reviewNote / reviewerId` only hold the LATEST decision
// (that is what the lists show); this table keeps all of them, so a project that was rejected by
// one mentor and approved later by another still shows who decided what and when.
// A PENDING row means an admin reopened the project (it went back to the queue).
model ProjectReview {
  id         String        @id @default(uuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  status     ProjectStatus
  note       String?
  createdAt  DateTime      @default(now())

  @@index([projectId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("project_reviews")
}
